# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=your-database-name
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (JWT)
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=1d

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="LibIO <noreply@libio.com>"

# Python gRPC Service
PYTHON_GRPC_URL=localhost:50051