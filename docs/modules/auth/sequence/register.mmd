sequenceDiagram    
    actor Reader as Reader
    participant Flutter as Flutter App
    participant AuthModule as Auth Module
    participant UserModule as User Module
    participant CacheModule as Cache Module
    participant EventModule as Event Module

    Reader->>Flutter: User fills registration form
    Flutter->>+AuthModule: register(regiserReq)
    
    AuthModule->>+UserModule: isEmailExist(email)
    UserModule-->>-AuthModule: return isExist
    
    alt Email exists
        AuthModule-->>Flutter: throw new ConflictException()
    else Email does not exist
        AuthModule->>+CacheModule: get(cacheKey)
        CacheModule-->>-AuthModule: return data
        alt Cache hit
            AuthModule-->>Flutter: throw new ConflictException()
        else Cache miss
            AuthModule->>+CacheModule: set(cacheKey, data)
            CacheModule-->>-AuthModule: return true
            AuthModule--)EventModule: publish(UserRegisteredEvent)
            AuthModule-->>Flutter: return RegisterPendingRes
            Flutter->>Reader: Redirect to verification page
        end
    end