flowchart TD
    %% Entity Relationship & Architecture Diagram for Reader and Staff Services

    subgraph ClientLayer ["Client / Controller Layer"]
        ReqCreateReader["ReaderCreateReq\n(email, password, fullName, phone, dob)"]
        ReqUpdateReader["ReaderUpdateReq\n(fullName, phone, dob, id?)"]
        ReqCreateStaff["StaffCreateReq\n(email, password, name)"]
        ReqUpdateStaff["StaffUpdateReq\n(name, id?)"]
    end

    subgraph UserModule ["User Module (Application Layer)"]
        subgraph ReaderServiceLayer ["ReaderService"]
            CreateReaderFlow["createReader(req)\n1. Check email uniqueness\n2. Hash password (bcrypt)\n3. Transaction: Save User + Reader\n4. Map to ReaderRes"]
            UpdateReaderFlow["updateReader(id, req)\n1. Check user exists (404)\n2. Check role == READER (403)\n3. Check reader exists (404)\n4. Update fields & save\n5. Map to ReaderRes"]
        end

        subgraph StaffServiceLayer ["StaffService"]
            CreateStaffFlow["createStaff(req)\n1. Check email uniqueness\n2. Hash password (bcrypt)\n3. Transaction: Save User + Staff\n4. Map to StaffRes"]
            UpdateStaffFlow["updateStaff(id, req)\n1. Check user exists (404)\n2. Check role == STAFF (403)\n3. Check staff exists (404)\n4. Update fields & save\n5. Map to StaffRes"]
        end
    end

    subgraph PersistenceLayer ["Persistence Layer (TypeORM / PostgreSQL)"]
        DataSourceTx["DataSource Transaction\n(Atomic Commit / Rollback)"]
        UserTable[("users table\nid: uuid (PK)\nemail: varchar (UQ)\nrole: enum (reader|staff|admin)\npassword_hash: varchar\nstatus: enum")]
        ReaderTable[("readers table\nid: uuid (PK, FK -> users.id)\nfull_name: varchar\nphone: varchar\ndate_of_birth: date\nregistered_at: timestamp\nupdated_at: timestamp")]
        StaffTable[("staffs table\nid: uuid (PK, FK -> users.id)\nname: varchar\ncreated_at: timestamp")]
    end

    subgraph ResponseLayer ["Response DTOs"]
        ReaderResDto["ReaderRes\n(id, fullName, phone, dob, regAt, user: UserRes)"]
        StaffResDto["StaffRes\n(id, name, createdAt, user: UserRes)"]
    end

    %% Connections
    ReqCreateReader --> CreateReaderFlow
    ReqUpdateReader --> UpdateReaderFlow
    ReqCreateStaff --> CreateStaffFlow
    ReqUpdateStaff --> UpdateStaffFlow

    CreateReaderFlow --> DataSourceTx
    CreateStaffFlow --> DataSourceTx
    DataSourceTx --> UserTable
    DataSourceTx --> ReaderTable
    DataSourceTx --> StaffTable

    UpdateReaderFlow --> UserTable
    UpdateReaderFlow --> ReaderTable
    UpdateStaffFlow --> UserTable
    UpdateStaffFlow --> StaffTable

    CreateReaderFlow --> ReaderResDto
    UpdateReaderFlow --> ReaderResDto
    CreateStaffFlow --> StaffResDto
    UpdateStaffFlow --> StaffResDto
