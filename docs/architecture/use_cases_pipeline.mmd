flowchart TD
    subgraph Client["gRPC Caller (FaceServiceServicer)"]
        Req["Request: image_bytes"]
    end

    subgraph Pipeline["Use Case Pipeline: Detector -> Liveness -> Embedder"]
        subgraph Step1["Step 1: Face Detection & Quality"]
            DetCall["detector.detect(image_bytes)"]
            CheckFaces{"Số khuôn mặt phát hiện"}
            ErrZero["Raise FaceNotFoundException"]
            ErrMulti["Raise MultipleFacesDetectedException"]
            QualityCheck{"face.validate_quality()"}
            ErrQuality["Raise LowFaceQualityException"]
        end

        subgraph Step2["Step 2: Anti-Spoofing Liveness Check"]
            LiveCall["liveness_detector.check_liveness(image_bytes)"]
            CheckLive{"result.is_live & status == REAL?"}
            ErrSpoof["Raise SpoofDetectedException"]
        end

        subgraph Step3["Step 3: Embedding Extraction"]
            EmbCall["embedder.extract_embedding(image_bytes, bbox)"]
            ReturnEmb["Return FaceEmbedding"]
        end

        subgraph Step4["Step 4: Verification (VerifyFaceUseCase only)"]
            DimCheck{"Dim candidate == Dim ref?"}
            ErrDim["Raise EmbeddingMismatchException"]
            SimCalc["similarity_calculator.compute_cosine_similarity()"]
            ScoreCheck{"similarity >= threshold"}
            ReturnVerify["Return (is_matched, similarity_score)"]
        end
    end

    Req --> DetCall
    DetCall --> CheckFaces
    CheckFaces -->|Count == 0| ErrZero
    CheckFaces -->|Count > 1| ErrMulti
    CheckFaces -->|Count == 1| QualityCheck
    QualityCheck -->|Failed| ErrQuality
    QualityCheck -->|Passed| LiveCall

    LiveCall --> CheckLive
    CheckLive -->|Spoof / False| ErrSpoof
    CheckLive -->|Real / True| EmbCall

    EmbCall --> ReturnEmb
    ReturnEmb --> DimCheck
    DimCheck -->|Mismatch| ErrDim
    DimCheck -->|Match| SimCalc
    SimCalc --> ScoreCheck
    ScoreCheck --> ReturnVerify
