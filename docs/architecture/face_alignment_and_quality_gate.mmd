flowchart TD
    subgraph Input["Input Data"]
        RawImage["Image Bytes (JPEG/PNG)"]
    end

    subgraph DetectionAndQuality["Stage 1: Detection & Face Quality Gate"]
        Detect["InsightFaceDetector.detect(image_bytes)"]
        RawFaces{"Số lượng khuôn mặt?"}
        ErrNotFound["FaceNotFoundException"]
        ErrMulti["MultipleFacesDetectedException"]

        FaceCrop["Crop Face Region via BBox"]
        CalcLaplacian["Compute Laplacian Variance\nvar = cv2.Laplacian(gray).var()"]
        SetBlur["Set face.blur_score = var"]

        QualityGate{"Quality Gate Validation\nface.validate_quality()"}
        CheckBlur{"Laplacian var >= 100?"}
        CheckSize{"BBox >= 80x80 px?"}
        CheckPose{"|pitch|, |yaw|, |roll| <= 20°?"}
        ErrQuality["Raise LowFaceQualityException"]
    end

    subgraph AlignmentStage["Stage 2: Standard ArcFace 112x112 Alignment"]
        Landmarks["Extract 5 Keypoints (kps)\nLeft/Right Eye, Nose, Mouth Corners"]
        Template["ArcFace 112x112 Template (ARCFACE_DST_112)\nStandard InsightFace Reference Points"]
        EstimateAffine["cv2.estimateAffinePartial2D(src_kps, dst_template)"]
        WarpAffine["cv2.warpAffine(img, M, (112, 112))\nAligned 112x112 Face Image"]
    end

    subgraph EmbeddingStage["Stage 3: Feature Extraction & L2 Normalization"]
        Backbone["InsightFaceEmbedder (buffalo_l / ResNet-50)\nrec.get_feat(aligned_112x112)"]
        RawVector["Raw Feature Vector (512-d)"]
        L2Norm["Enforce L2 Normalization\nv_norm = v / (||v||_2 + 1e-12)"]
        FaceEmb["Domain Value Object: FaceEmbedding\nvalues=512, dim=512, ||v||_2 = 1.0"]
    end

    subgraph VerificationStage["Stage 4: Multi-Sample Enrollment & Verification"]
        subgraph MultiEnroll["Multi-Sample Enrollment (3-5 Images)"]
            MultiEmbs["Extract N L2-Normalized Embeddings\ne_1, e_2, ..., e_N"]
            MeanEmb["Average Embedding\ne_mean = (1/N) * sum(e_i)"]
            TemplateNorm["Enforce L2 Norm on Template\ne_template = e_mean / ||e_mean||_2"]
        end

        subgraph ProbeMatch["Probe Verification & Matching"]
            ProbeEmb["Probe FaceEmbedding (e_probe)"]
            DotProduct["Cosine Similarity = Dot Product\nsimilarity = dot(e_probe, e_template)"]
            ThresholdCheck{"similarity >= FACE_MATCH_THRESHOLD\n(Default: 0.68)"}
            MatchedResult["MATCHED: Cùng một người"]
            UnmatchedResult["UNMATCHED: Khác người"]
        end
    end

    RawImage --> Detect
    Detect --> RawFaces
    RawFaces -->|Count == 0| ErrNotFound
    RawFaces -->|Count > 1| ErrMulti
    RawFaces -->|Count == 1| FaceCrop
    FaceCrop --> CalcLaplacian --> SetBlur --> QualityGate

    QualityGate --> CheckBlur
    QualityGate --> CheckSize
    QualityGate --> CheckPose
    CheckBlur -->|"< 100"| ErrQuality
    CheckSize -->|"< 80x80"| ErrQuality
    CheckPose -->|"> 20°"| ErrQuality

    QualityGate -->|Passed| Landmarks
    Landmarks --> EstimateAffine
    Template --> EstimateAffine
    EstimateAffine --> WarpAffine

    WarpAffine --> Backbone
    Backbone --> RawVector
    RawVector --> L2Norm
    L2Norm --> FaceEmb

    FaceEmb --> MultiEmbs
    MultiEmbs --> MeanEmb --> TemplateNorm
    TemplateNorm --> DotProduct
    ProbeEmb --> DotProduct
    DotProduct --> ThresholdCheck
    ThresholdCheck -->|True| MatchedResult
    ThresholdCheck -->|False| UnmatchedResult
